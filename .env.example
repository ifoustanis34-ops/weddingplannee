# Copy to .env (`make dev` does it automatically) and adjust.

# Django
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-in-every-environment-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
DJANGO_SETTINGS_MODULE=config.settings.dev
LOG_LEVEL=INFO

# PostgreSQL: non-superuser `wedivo` role created by infra/postgres/init-app-role.sql
DATABASE_URL=postgres://wedivo:wedivo@db:5432/wedivo

# Redis: db 0 Celery broker, db 1 cache, db 2 rate limits / locks
REDIS_URL=redis://redis:6379

# Browser origins allowed to call the API with cookies
CORS_ALLOWED_ORIGINS=http://localhost:8090
CSRF_TRUSTED_ORIGINS=http://localhost:8090

# MinIO (S3-compatible storage, local only)
MINIO_ROOT_USER=wedivo
MINIO_ROOT_PASSWORD=wedivo-minio-secret

# Multi-tenant: companies live on <slug>.<TENANT_BASE_DOMAIN>; dev also accepts the X-Organization header
TENANT_BASE_DOMAIN=wedivo.app
FRONTEND_URL=http://localhost:8090
# Master key of the ticket signatures (HKDF per organization). Required in production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCUMENTS_MASTER_KEY=

# Account creations per IP and per hour (production default: 5). High in dev for e2e runs.
SIGNUP_RATE_LIMIT=1000

# Web Push notifications of the PWA: `docker compose ... exec api python manage.py generate_vapid_keys`
# Without keys no notification is sent and the app hides the switch.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@wedivo.app
